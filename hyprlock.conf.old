source = ~/.config/Ax-Shell/config/hypr/colors.conf

# BACKGROUND
background {
    monitor =
    path = ~/.current.wall
    blur_passes = 3
    blur_size = 3
    contrast = 1.0
    brightness = 0.5
}

# GENERAL
general {
    grace = 0
    hide_cursor = true
    fail_delay = 500
}

# INPUT FIELD
input-field {
    size = 260, 48
    outline_thickness = 0
    dots_size = 0.25
    dots_spacing = 0.6
    dots_center = true
    outer_color = rgba(00000000)
    inner_color = rgba(0, 0, 0, 1)
    font_color = rgb($foreground)
    fail_color = rgb($error)
    check_color = rgb($tertiary)
    capslock_color = rgb($secondary)
    placeholder_text = Enter password
    hide_input = false
    position = 0, -100
    halign = center
    valign = center
    font_family = Iosevka Nerd Font
}

# TIME
label {
    text = cmd[update:1000] echo "$(date +'%H:%M')"
    color = rgb($foreground)
    font_size = 36
    font_family = Iosevka Nerd Font Bold
    position = 0, -180
    halign = center
    valign = center
}

# USERNAME
label {
    text = Afsal
    color = rgb($foreground)
    font_size = 18
    font_family = Iosevka Nerd Font Bold Italic
    position = 0, -60
    halign = center
    valign = center
}

# PROFILE PICTURE
image {
    path = ./pfp.jpg
    size = 180
    position = 0, 70
    halign = center
    valign = center
    border_size = 3
    border_color = rgb($primary)
}

