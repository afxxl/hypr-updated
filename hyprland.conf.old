
# ================================
#        CLEAN HYPRLAND CONFIG
#      FOR AX-SHELL (Arch Linux)
# ================================

# Monitor setup (auto-detect)
monitor = ,preferred,auto,1.2

# ================================
# Environment
# ================================
env = XDG_CURRENT_DESKTOP,Hyprland
env = XDG_SESSION_TYPE,wayland
env = XDG_SESSION_DESKTOP,Hyprland
env = MOZ_ENABLE_WAYLAND,1
env = QT_QPA_PLATFORM,wayland;xcb
env = QT_WAYLAND_DISABLE_WINDOWDECORATION,1
env = GDK_SCALE,1

# ================================
# Input
# ================================
input {
    kb_layout = us
    follow_mouse = 1
    kb_options = ctrl:nocaps

    touchpad {
        natural_scroll = yes
        scroll_factor = 1.0
        disable_while_typing = false
        tap-and-drag = true
        tap-to-click = true
disable_while_typing = true

    }

    sensitivity = 0
    numlock_by_default = true
}




# ================================
# Window rules / misc
# ================================
device {
    name = epic mouse V1
    sensitivity = 1.5
}

dwindle {
    pseudotile = yes
    preserve_split = yes
}

master {
    new_status = master
}

misc {
    vrr = 0
    disable_hyprland_logo = true
    disable_splash_rendering = true
    force_default_wallpaper = 0
}

xwayland {
    force_zero_scaling = true
}



# 3-finger swipe left/right for workspace switch
gesture = 3, horizontal, workspace

# ================================
# Autostart — ONLY Ax-Shell things
# ================================
# ================================
# Autostart — ONLY Ax-Shell things
# ================================

# Reset portals
exec-once = dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP
exec-once = systemctl --user import-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP

# Ax-Shell UI - FIXED SYNTAX
#exec-once = uwsm-app -- python ~/.config/Ax-Shell/main.py


# Ax-Shell clipboard, idle, etc handled internally

# ================================
# REMOVE all Hyprdots/HYDE sources
#/home/afsal/.config/hypr/keybindings.conf ================================
# source = ~/.config/hypr/animations.conf
 source = ~/.config/hypr/keybindings.conf
